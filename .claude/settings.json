      "source": {
        "source": "github",
        "repo": "kingbootoshi/cartographer"
      }
    },
    "thedotmack": {
      "source": {
        "source": "github",
        "repo": "thedotmack/claude-mem"
      }
    },
    "headroom-marketplace": {
      "source": {
        "source": "github",
        "repo": "headroomlabs-ai/headroom"
      }
